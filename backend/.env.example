# Replace before any public deployment. Use a long random value.
# Leave DATABASE_URL commented for local SQLite; set it when using PostgreSQL.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Africa/Harare

# PostgreSQL. If DATABASE_URL is omitted, Django uses local SQLite for quick development.
# DATABASE_URL=postgresql://ims_user:change-me@localhost:5432/internship_management
DATABASE_SSL=False

CORS_ALLOWED_ORIGINS=http://localhost:5173
MEDIA_ROOT=./media
